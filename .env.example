# Only the CLI loads this file, with --env-file. No implicit .env discovery.
WP_URL=https://wordpress.example
WP_AUTH=application-password
WP_USERNAME=
WP_PASSWORD=
WP_NETWORK=false
# Optional CAS settings (WP_AUTH=cas):
CAS_LOGIN_URL=https://login.example/cas/login
# CAS_SERVICE_URL=https://wordpress.example/wp-admin/
# CAS_ENTRY_URL=https://wordpress.example/wp-login.php
# WP_ADMIN_URL=https://wordpress.example/wp-admin/
# WP_COOKIE=
# WP_NONCE=
# Disposable local HTTP tests only:
# WP_ALLOW_HTTP=true
